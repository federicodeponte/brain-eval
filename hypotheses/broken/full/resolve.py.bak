import ast, json, re
def _s(node):
    """Render a string-ish AST node; f-string placeholders become '{}'."""
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    if isinstance(node, ast.JoinedStr):
        return "".join(v.value if isinstance(v, ast.Constant) else "{}" for v in node.values)
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
        a, b = _s(node.left), _s(node.right)
        return None if a is None or b is None else a + b
    return None
def resolve_var(traj):
    """Last command that json.dumps a dict with data_issues=<Name>: resolve Name from that script's assignments."""
    best = None
    for l in open(traj):
        e = json.loads(l); it = e.get("item", {})
        if e.get("type") != "item.completed" or it.get("type") != "command_execution":
            continue
        cmd = it.get("command") or ""
        m = re.search(r"<<\s*'?(\w+)'?\n(.*)\n\1", cmd, re.S)
        if not m:
            continue
        code = m.group(2).replace('\\"', '"').replace("\\$", "$").replace("\\`", "`")
        try:
            tree = ast.parse(code)
        except SyntaxError:
            continue
        target = None
        for n in ast.walk(tree):
            if isinstance(n, ast.Dict):
                for k, v in zip(n.keys, n.values):
                    if isinstance(k, ast.Constant) and k.value == "data_issues":
                        target = v
        if target is None:
            continue
        if isinstance(target, ast.IfExp):  # "; ".join(issues) if issues else "none"
            target = target.body
        val = _s(target)
        if val is None:
            name = None
            if isinstance(target, ast.Name):
                name = target.id
            elif isinstance(target, ast.Call) and isinstance(target.func, ast.Attribute) and target.func.attr == "join" and target.args and isinstance(target.args[0], ast.Name):
                name = target.args[0].id
            if name:
                parts = []
                for n in ast.walk(tree):
                    if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == name for t in n.targets):
                        sv = _s(n.value)
                        if sv is not None:
                            parts = [sv]
                        elif isinstance(n.value, (ast.List, ast.Tuple)):
                            parts = [x for x in (_s(el) for el in n.value.elts) if x]
                    if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute) and n.func.attr == "append" and isinstance(n.func.value, ast.Name) and n.func.value.id == name and n.args:
                        sv = _s(n.args[0])
                        if sv:
                            parts.append(sv)
                val = "; ".join(parts) if parts else None
        if val:
            best = val
    return best
